# 本体(smdx_api)の環境変数。コピーして .env を作り、値を設定する(.env はコミットしない)
# 項目と既定値は 設計書/詳細設計書.md「設定項目」の「環境変数」に従う

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supermarket_dx
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
WEATHER_API_TIMEOUT_SECONDS=10
STORE_LATITUDE=35.6895
STORE_LONGITUDE=139.6917
MODEL_DAILY_PATH=models/daily.joblib
MODEL_TIME_BAND_PATH=models/time_band.joblib
CORS_ALLOW_ORIGINS=http://localhost:5173
# 必須。十分に長いランダムな文字列にする(例: python -c "import secrets; print(secrets.token_urlsafe(48))")
SESSION_SECRET=
# 評価環境(HTTPS)では true にする
SESSION_COOKIE_SECURE=false
# 最後の操作からこの時間(時間)が経つとログアウトになる
SESSION_MAX_AGE_HOURS=3
# コンテナの OS のタイムゾーン(ログの時刻など)。本体の日時の計算はこの値によらず Asia/Tokyo で行う
TZ=Asia/Tokyo
# 取込ファイルの上限(MB)。超えると 413 で拒否する(過去分は期間を分けて取り込む)
IMPORT_MAX_MB=50
# 同じログインIDでこの回数続けて失敗すると、LOGIN_LOCK_MINUTES(分)の間ログインできなくなる
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# /docs・/redoc・/openapi.json を出すか(インターネットから届く評価環境では false にする)
API_DOCS_ENABLED=true
