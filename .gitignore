# ---- ルート直下は許可したものだけをコミット対象にする ----
# まずルート直下をすべて除外し、! で必要なものだけ除外を解除する。

/*
!/app/
!/設計書/
!/テスト/
!/提案資料/
!/.gitignore
!/CLAUDE.md

# .claude/ は settings.json(チーム共有設定)だけをコミット対象にする
!/.claude/
/.claude/*
!/.claude/settings.json

# ---- app/ 配下で Git に含めないもの(技術スタック・ファイル構成 2.4) ----

# モデルファイル(学習データ由来・サイズが大きい)
/app/backend/models/*.joblib
/app/model_training/output/

# 生成したサンプルデータ(コマンドで再生成できる)
/app/sample_data/output/

# Jupyter Notebook の自動保存
.ipynb_checkpoints/

# ---- 一般的な除外(全階層が対象) ----

# 秘密情報・環境変数(.env.example はコミット対象)
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Node.js / フロントエンド
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*

# ローカルDB・ログ
*.db
*.sqlite3
*.log

# ツール作業用
.superpowers/

# OS・エディタ
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
~$*
